---
import DeviceScene from './DeviceScene.astro'
import SiteHeader from './SiteHeader.astro'
import { homeContent, type Locale } from '../i18n/product-site'

interface Props {
  locale?: Locale
}

const { locale = 'en' } = Astro.props
const t = homeContent[locale]
---

<DeviceScene />
<SiteHeader locale={locale} />

<main id='top' class='wl-main wl-home'>
  <section class='wl-section wl-hero' data-scene='hero'>
    <div class='wl-copy wl-hero-copy'>
      <h1>
        {
          Array.isArray(t.hero.title)
            ? t.hero.title.map((line) => <span class='wl-title-line'>{line}</span>)
            : t.hero.title
        }
      </h1>
      <p class='wl-hero-description'>{t.hero.description}</p>
      <div class='wl-stats' aria-label={locale === 'zh' ? '客户数据' : 'Adoption'}>
        {
          t.hero.stats.map((stat) => (
            <div>
              <strong>{stat.value}</strong>
              <span>{stat.label}</span>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  {
    t.series.map((series) => (
      <section
        id={series.id}
        class='wl-section wl-series'
        data-scene={series.scene}
      >
        <div class='wl-copy'>
          <h2>{series.title}</h2>
          <p class='wl-lede'>{series.description}</p>
          <ul class='wl-feature-list'>
            {series.features.map((feature) => <li>{feature}</li>)}
          </ul>
          <div class='wl-applications'>
            <h3>{series.applicationTitle}</h3>
            <p>{series.applications.join(' · ')}</p>
          </div>
          <div class='wl-actions'>
            {series.ctas.map((cta, index) => (
              <a href={series.href} data-cta-index={index + 1}>{cta}<span>↗</span></a>
            ))}
          </div>
        </div>
      </section>
    ))
  }

  <section id='advantages' class='wl-section wl-advantages' data-scene='advantages'>
    <div class='wl-copy'>
      <h2>{t.advantages.title}</h2>
      <ol class='wl-advantage-list'>
        {
          t.advantages.items.map((item, index) => (
            <li>
              <div class='wl-advantage-number'>{String(index + 1).padStart(2, '0')}</div>
              <div>
                <h3>{item.title}</h3>
                {item.metrics && (
                  <p class='wl-advantage-metrics'>
                    {item.metrics.before}<strong>{item.metrics.first}</strong>{item.metrics.between}<strong>{item.metrics.second}</strong>{item.metrics.after}
                  </p>
                )}
                {item.bullets.length > 0 && (
                  <ul>{item.bullets.map((bullet) => <li>{bullet}</li>)}</ul>
                )}
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section id='contact' class='wl-section wl-contact' data-scene='contact'>
    <div class='wl-copy'>
      <h2>{t.contact.title}</h2>
      <dl class='wl-contact-list'>
        <div>
          <dt>{t.contact.businessLabel}</dt>
          <dd>
            <a href={`mailto:${t.contact.emails[0]}`}>{t.contact.emails[0]}</a>
            <a href={`tel:${t.contact.phones[0]}`}>{t.contact.phones[0]}</a>
            <a href={`mailto:${t.contact.emails[1]}`}>{t.contact.emails[1]}</a>
            <a href={`tel:${t.contact.phones[1]}`}>{t.contact.phones[1]}</a>
          </dd>
        </div>
        <div><dt>{t.contact.addressLabel}</dt><dd>{t.contact.address}</dd></div>
        <div><dt>{t.contact.wechatLabel}</dt><dd>{t.contact.wechat}</dd></div>
      </dl>
      <p class='wl-copyright'>{t.contact.copyright}</p>
    </div>
  </section>
</main>

<script>
  document.documentElement.classList.add('app-ready')
</script>
